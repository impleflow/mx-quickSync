# Default: git detects text files itself and normalizes their line endings to LF in the repository
* text=auto

# Python and Java sources and YAML configuration: always LF (also after checkout on Windows)
*.py   text eol=lf diff=python
*.java text eol=lf diff=java
*.yaml text eol=lf
*.yml  text eol=lf

# Documentation and helper files
*.md        text eol=lf diff=markdown
*.txt       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.json      text eol=lf
LICENSE     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Shell scripts must have LF, otherwise they do not run on Linux
*.sh text eol=lf

# Binary files (do not change line endings, do not show diffs)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gz   binary
*.pyc  binary

# Large binary files are kept in Git LFS
*.jar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
